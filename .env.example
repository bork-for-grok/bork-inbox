# bork-inbox settings. Copy to a private file (mode 600), fill in, and never commit it.
# Generate each token with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Comma-separated party names (a-z, 0-9, -). Each party is one bot.
BORK_INBOX_PARTIES=alice-bot,bob-bot

# Optional: restrict who may send to whom. Default: every party to every other party.
# BORK_INBOX_ROUTES=alice-bot>bob-bot,bob-bot>alice-bot

# One bearer token per party. Env suffix = party name upper-cased, "-" -> "_".
# The two values below are deliberately too short (the server needs 32+ characters), so the server
# refuses to start until you replace BOTH with real tokens. Generate one per party with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BORK_INBOX_TOKEN_ALICE_BOT=REPLACE_ME
BORK_INBOX_TOKEN_BOB_BOT=REPLACE_ME_TOO

# Optional wake webhooks: POSTed (metadata only) when a message lands in that party's inbox.
# Leave both empty to disable. The URL must be https:// (redirects are never followed).
BORK_INBOX_WEBHOOK_URL_ALICE_BOT=
BORK_INBOX_WEBHOOK_KEY_ALICE_BOT=
BORK_INBOX_WEBHOOK_URL_BOB_BOT=
BORK_INBOX_WEBHOOK_KEY_BOB_BOT=

# Where messages are stored. Default: ~/.local/share/bork-inbox/tasks
# BORK_INBOX_DATA_DIR=/var/lib/bork-inbox/tasks

# Loopback bind only (127.0.0.1, ::1 or localhost). Put a TLS reverse proxy or tunnel in front.
BORK_INBOX_HOST=127.0.0.1
BORK_INBOX_PORT=8800

# Optional: Host names your reverse proxy forwards (kept on the DNS rebinding allowlist).
# BORK_INBOX_PUBLIC_HOSTS=inbox.example.internal

# Time zone used for message timestamps (IANA name). Default: UTC
# BORK_INBOX_TZ=UTC
