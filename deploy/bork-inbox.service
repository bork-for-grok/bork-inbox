# systemd user unit template for bork-inbox.
# Replace every {{PLACEHOLDER}}, then install with deploy/install-user-unit.sh
# or copy to ~/.config/systemd/user/bork-inbox.service.
[Unit]
Description=bork-inbox MCP inbox server (loopback)
After=network.target

[Service]
Type=simple
WorkingDirectory={{INSTALL_DIR}}
ExecStart={{INSTALL_DIR}}/.venv/bin/python -m bork_inbox
# Private settings file (mode 600) holding tokens and webhook secrets.
EnvironmentFile={{ENV_FILE}}
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
